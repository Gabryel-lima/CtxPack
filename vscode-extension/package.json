{
  "name": "ctxpack",
  "displayName": "CtxPack",
  "description": "FIFO context buffer for Copilot Chat in VS Code",
  "version": "1.2.0",
  "publisher": "Gabryel-lima",
  "icon": "assets/ctxpack.png",
  "license": "MIT",
  "homepage": "https://github.com/Gabryel-lima/CtxPack",
  "bugs": {
    "url": "https://github.com/Gabryel-lima/CtxPack/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabryel-lima/CtxPack.git"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "context",
    "prompt",
    "chat",
    "buffer",
    "workflow"
  ],
  "galleryBanner": {
    "color": "#0f1419",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ctxpack.push",
        "title": "CtxPack: Push selection to buffer"
      },
      {
        "command": "ctxpack.pushFile",
        "title": "CtxPack: Push entire file to buffer"
      },
      {
        "command": "ctxpack.pushPath",
        "title": "CtxPack: Push file or directory to buffer"
      },
      {
        "command": "ctxpack.pushExplorerFile",
        "title": "CtxPack: Push this file to buffer"
      },
      {
        "command": "ctxpack.pushExplorerFolder",
        "title": "CtxPack: Push this folder to buffer"
      },
      {
        "command": "ctxpack.clear",
        "title": "CtxPack: Clear context buffer"
      },
      {
        "command": "ctxpack.selectActiveSlots",
        "title": "CtxPack: Choose active slots for dynamic context"
      },
      {
        "command": "ctxpack.clearActiveSelection",
        "title": "CtxPack: Clear active slot filter"
      },
      {
        "command": "ctxpack.status",
        "title": "CtxPack: View buffer status"
      },
      {
        "command": "ctxpack.slotScopeStatus",
        "title": "CtxPack: Show current dynamic context scope"
      },
      {
        "command": "ctxpack.inspectSlot",
        "title": "CtxPack: Inspect buffered slot"
      },
      {
        "command": "ctxpack.removeSlot",
        "title": "CtxPack: Remove buffered slot"
      },
      {
        "command": "ctxpack.exportSemantic",
        "title": "CtxPack: Generate semantic project pack"
      },
      {
        "command": "ctxpack.exportReadable",
        "title": "CtxPack: Generate readable project pack"
      },
      {
        "command": "ctxpack.pushWorkspaceSemantic",
        "title": "CtxPack: Generate semantic pack and push to buffer"
      },
      {
        "command": "ctxpack.queryWorkspace",
        "title": "CtxPack: Query workspace and push targeted context"
      },
      {
        "command": "ctxpack.createPackignore",
        "title": "CtxPack: Create .packignore template"
      },
      {
        "command": "ctxpack.wizard",
        "title": "CtxPack: Open context workflow wizard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ctxpack.pushExplorerFile",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@100"
        },
        {
          "command": "ctxpack.pushExplorerFolder",
          "when": "explorerResourceIsFolder == true",
          "group": "navigation@100"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "ctxpack.assistant",
        "name": "ctx",
        "description": "Copilot with dynamic CtxPack buffered context",
        "commands": [
          {
            "name": "run",
            "description": "Force agentic execution with tools using CtxPack buffered context"
          }
        ],
        "isSticky": true
      }
    ],
    "keybindings": [
      {
        "command": "ctxpack.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CtxPack",
      "properties": {
        "ctxpack.maxTokens": {
          "type": "number",
          "default": 8000,
          "description": "Buffer token limit (FIFO eviction when exceeded)"
        },
        "ctxpack.maxFilesPerPathPush": {
          "type": "number",
          "default": 25,
          "description": "Maximum number of files collected when pushing a directory as one slot"
        },
        "ctxpack.maxFileBytesPerPathPush": {
          "type": "number",
          "default": 200000,
          "description": "Maximum size in bytes per file when pushing a file or directory path"
        },
        "ctxpack.autoInjectOnPack": {
          "type": "boolean",
          "default": true,
          "description": "Reserved for future chat automation. IPC pushes already update the buffer immediately."
        },
        "ctxpack.debugPromptRouting": {
          "type": "boolean",
          "default": false,
          "description": "Enable console diagnostics for command/mode routing and tool forwarding in @ctx requests."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo 'Lint not configured yet'",
    "test": "jest",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "@vscode/chat-extension-utils": "0.0.0-alpha.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  }
}
